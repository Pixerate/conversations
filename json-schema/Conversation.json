{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "entity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "default": "task",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "id"
      ]
    },
    "anchor": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "quote": {
          "type": "object",
          "properties": {
            "exact": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            },
            "suffix": {
              "type": "string"
            }
          },
          "required": [
            "exact"
          ]
        },
        "state": {
          "default": "attached",
          "type": "string",
          "enum": [
            "attached",
            "orphaned"
          ]
        }
      },
      "required": [
        "start",
        "end",
        "quote"
      ]
    },
    "status": {
      "default": "open",
      "type": "string",
      "enum": [
        "open",
        "resolved",
        "archived"
      ]
    },
    "participantIds": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "messageCount": {
      "default": 0,
      "type": "number",
      "minimum": 0
    },
    "lastMessageAt": {
      "type": "string"
    },
    "resolvedAt": {
      "type": "string"
    },
    "resolvedBy": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "entity",
    "createdAt",
    "updatedAt"
  ]
}
