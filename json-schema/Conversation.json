{
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "entity": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "default": "task"
        },
        "title": {
          "type": "string"
        },
        "projectId": {
          "type": "string"
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "anchor": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        },
        "quote": {
          "type": "object",
          "properties": {
            "exact": {
              "type": "string"
            },
            "prefix": {
              "type": "string"
            },
            "suffix": {
              "type": "string"
            }
          },
          "required": [
            "exact"
          ],
          "additionalProperties": false
        },
        "state": {
          "type": "string",
          "enum": [
            "attached",
            "orphaned"
          ],
          "default": "attached"
        }
      },
      "required": [
        "start",
        "end",
        "quote"
      ],
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "resolved",
        "archived"
      ],
      "default": "open"
    },
    "participantIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "messageCount": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "lastMessageAt": {
      "type": "string"
    },
    "resolvedAt": {
      "type": "string"
    },
    "resolvedBy": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {}
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "entity",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
