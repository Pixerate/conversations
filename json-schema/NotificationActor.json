{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "avatarUrl": {
      "type": "string"
    },
    "type": {
      "default": "user",
      "type": "string",
      "enum": [
        "user",
        "agent",
        "system"
      ]
    }
  },
  "required": [
    "id"
  ]
}
