{
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "conversationId": {
      "type": "string"
    },
    "author": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "avatarUrl": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "user",
            "agent",
            "system"
          ],
          "default": "user"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "content": {
      "type": "string"
    },
    "richContent": {
      "type": "string"
    },
    "parentId": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "sent",
        "pending",
        "failed",
        "deleted"
      ],
      "default": "sent"
    },
    "mentions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "stickers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": {}
      },
      "default": []
    },
    "reactions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "emoji": {
            "type": "string"
          },
          "sticker": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "emoji",
          "userId"
        ],
        "additionalProperties": false
      },
      "default": []
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {}
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "conversationId",
    "author",
    "content",
    "createdAt"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
